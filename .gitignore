# .gitignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
*.egg

# Virtual environments
venv/
.env/
.env
.venv/
ENV/
env/

# Environment variables
.env

# Logs
*.log

# Database dumps / backups
*.sql
*.dump
*.backup
backups/

# OS files
.DS_Store
Thumbs.db

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# Python testing / coverage
.pytest_cache/
.coverage
htmlcov/

# Mypy / type checking
.mypy_cache/
.dmypy.json

# Ruff / linters
.ruff_cache/

# Misc
*.tmp
*.bak
